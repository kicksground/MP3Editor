{
  "name": "MP3 편집기",
  "short_name": "MP3 편집기",
  "description": "설치 없이 브라우저에서 바로 쓰는 오디오 편집기",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#12141a",
  "theme_color": "#12141a",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "audio/mpeg": [".mp3"],
        "audio/wav": [".wav"],
        "audio/x-wav": [".wav"],
        "audio/mp4": [".m4a"],
        "audio/aac": [".aac"],
        "audio/ogg": [".ogg"],
        "audio/flac": [".flac"],
        "video/mp4": [".mp4"]
      }
    }
  ]
}
